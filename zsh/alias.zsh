alias vi="nvim"
alias vim="nvim"
alias view="nvim -R"
alias l="ls"
alias ls="ls -FG"
alias la="ls -a"
alias ll="ls -l"
alias lla="ls -la"
alias grep="grep --color"

# Dir
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."

# Config
alias kittyconf="vi ~/.config/kitty/kitty.conf"
alias tmuxconf="vi ~/.tmux.conf"
alias vimrc="vi ~/.vimrc"
alias dotfiles="vi ~/dotfiles"

# Claude Code
alias claudemf="CLAUDE_CONFIG_DIR=$HOME/.claude-mf claude"
